{
  "name": "alasas-floor-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/customer",
    "apps/admin",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build:all",
    "build:all": "npm run build:customer && npm run build:admin && node scripts/prepare-pages.mjs",
    "build:customer": "npm run build --workspace apps/customer",
    "build:admin": "npm run build --workspace apps/admin",
    "dev:customer": "npm run dev --workspace apps/customer",
    "dev:admin": "npm run dev --workspace apps/admin",
    "provision:super-admins": "npm run provision:super-admins --workspace apps/admin"
  }
}
