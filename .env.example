# Firebase web-app configuration for floor-232bc
# Copy this file to .env.local and fill from Firebase Console > Project settings > Your apps > Web app.
# These are public web SDK identifiers; never put service-account private keys or AI-provider secret keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=floor-232bc.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://floor-232bc-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=floor-232bc
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ORDER_BACKEND_ENDPOINT=
VITE_IMAGE_UPLOAD_ENDPOINT=
